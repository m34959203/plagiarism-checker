# --- Поисковые провайдеры -------------------------------------------------
# Скопируйте этот файл в .env и заполните ключом того провайдера, который
# используете. Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# serper.dev — по умолчанию, 2500 бесплатных запросов единоразово.
# Получить: зайти на https://serper.dev -> Sign up -> раздел "API Key".
SERPER_API_KEY=

# Пул ключей serper (необязательно): несколько ключей через запятую.
# Провайдер сам переключается на следующий, когда текущий упрётся в лимит (429),
# так суммарный бесплатный запас = 2500 × число ключей. Можно также нумеровать:
# SERPER_API_KEY_2=..., SERPER_API_KEY_3=... — всё объединяется.
SERPER_API_KEYS=

# Google Custom Search JSON API — 100 запросов/день бесплатно.
# Нужны и ключ, и идентификатор поисковой системы (CSE / cx).
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API — бесплатный тариф ~2000 запросов/мес.
BRAVE_API_KEY=

# --- Веб-приложение (необязательно) --------------------------------------
# Провайдер, потолок запросов за прогон и максимум объёма текста для веб-демо.
WEB_PROVIDER=serper
WEB_MAX_QUERIES=100
WEB_MAX_WORDS=15000
